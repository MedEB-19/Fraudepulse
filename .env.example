# Copy to .env  (cp .env.example .env). Never commit .env.

# --- Kafka (single-node KRaft) ---
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_TOPIC=fraud-transactions
KAFKA_DLQ_TOPIC=fraud-transactions-dlq
KAFKA_PARTITIONS=6
KAFKA_BROKER=kafka:29092

# --- MongoDB ---
MONGO_URI=mongodb://mongodb:27017/
MONGO_DB=fraud_db
MONGO_COLLECTION=transactions

# --- Producer ---
STREAM_DELAY_SECONDS=0.05
PRODUCER_LOOP=false
MAX_RECORDS=0

# --- Spark streaming ---
STARTING_OFFSETS=earliest
MAX_OFFSETS_PER_TRIGGER=5000
TRIGGER_SECONDS=5
FRAUD_THRESHOLD=0.5
RULE_AMOUNT=200000
# Pushgateway only exists with `make up-full`; if absent, metrics are skipped (a warning is logged once)
PROMETHEUS_PUSHGATEWAY=http://pushgateway:9091

# --- Training ---
XGB_NUM_WORKERS=2
TRAIN_SAMPLE_FRACTION=1.0
DATA_PATH=/app/data/paysim.csv

# --- Optional MLflow (docker compose -f docker-compose.yml -f docker-compose.mlops.yml up -d) ---
# MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=FraudPulse-XGBoost

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
